# Application
APP_NAME=Private Research Agent
ENVIRONMENT=DEVELOPMENT

# LLM Provider ("groq" for ultra-fast cloud, or "ollama" for 100% local)
LLM_PROVIDER=groq

# Groq Cloud LLM (Sign up for free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0.2

# Firecrawl & Search Providers
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
SEARCH_PROVIDER=firecrawl
FALLBACK_SEARCH_PROVIDER=duckduckgo

# Performance & Concurrency
MAX_CONCURRENT_SCRAPES=5
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=research_documents

# Embeddings (Local)
EMBEDDING_MODEL=BAAI/bge-m3

# Hybrid Retrieval (Dense + Lexical BM25)
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# Reranking (CPU-Friendly Cross-Encoder)
RERANKER_ENABLED=true
RERANKER_MODEL=ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=8
RERANKER_CANDIDATES=25

# Anti-Hallucination & Relevance
RELEVANCE_THRESHOLD=0.35
MAX_RESEARCH_ITERATIONS=3

# Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Data Directories
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_CACHE_DIR=data/cache
DATA_UPLOADS_DIR=data/uploads
SQLITE_DB_PATH=data/conversations.db

